generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum GameStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GameFileKind {
  GAME_BUILD
  COVER_IMAGE
  SCREENSHOT
  TRAILER
  OTHER
}

enum ClaimStatus {
  CLAIMED
  REVIEWED
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  username     String      @unique
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  games        Game[]
  claims       GameClaim[]
  reviews      Review[]

  @@map("users")
}

model Game {
  id          String      @id @default(uuid()) @db.Uuid
  creatorId   String      @map("creator_id") @db.Uuid
  title       String
  slug        String      @unique
  description String
  genre       String?
  status      GameStatus  @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  creator     User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  files       GameFile[]
  claims      GameClaim[]
  reviews     Review[]

  @@index([creatorId])
  @@index([status])
  @@map("games")
}

model GameFile {
  id        String       @id @default(uuid()) @db.Uuid
  gameId    String       @map("game_id") @db.Uuid
  kind      GameFileKind
  fileName  String       @map("file_name")
  url       String
  sizeBytes Int?         @map("size_bytes")
  createdAt DateTime     @default(now()) @map("created_at")
  game      Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_files")
}

model GameClaim {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  gameId    String      @map("game_id") @db.Uuid
  status    ClaimStatus @default(CLAIMED)
  createdAt DateTime    @default(now()) @map("created_at")
  reviewedAt DateTime?  @map("reviewed_at")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  review    Review?

  @@unique([userId, gameId])
  @@index([gameId])
  @@map("game_claims")
}

model Review {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  gameId    String    @map("game_id") @db.Uuid
  claimId   String    @unique @map("claim_id") @db.Uuid
  rating    Int
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  claim     GameClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
  @@map("reviews")
}
